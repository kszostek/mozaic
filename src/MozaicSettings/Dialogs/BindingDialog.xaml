<Window x:Class="Mozaic.Settings.Dialogs.BindingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Mozaic.Settings"
        Title="{l:T Shortcut}" Width="640" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="26,20,26,22">
        <TextBlock Text="{l:T Keys}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
        <l:KeyCaptureBox x:Name="Capture" FontSize="16" Padding="12,8" />
        <TextBlock Style="{StaticResource Secondary}" Margin="2,6,0,0"
                   Text="{l:T 'Click the box and press the keys. Mozaic shortcuts are paused meanwhile. Win+L is reserved by Windows.'}" />

        <TextBlock Text="{l:T Command}" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
        <ComboBox x:Name="CommandBox" IsEditable="True" FontFamily="{StaticResource MonoFont}" StaysOpenOnEdit="True" />
        <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
            <Border x:Name="CategoryDot" Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center" />
            <TextBlock x:Name="CommandHelp" Style="{StaticResource Secondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:T Mode}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                <ComboBox x:Name="ModeBox" MinWidth="180" HorizontalAlignment="Left" />
            </StackPanel>
            <CheckBox x:Name="ReleaseBox" Grid.Column="1" Content="{l:T Run when the keys are released}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="2,14,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{l:T Cancel}" IsCancel="True" Padding="18,6" Margin="0,0,8,0" />
            <Button Content="{l:T OK}" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}" Padding="26,6" />
        </StackPanel>
    </StackPanel>
</Window>
