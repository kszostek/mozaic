<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MozaicSettings</AssemblyName>
    <RootNamespace>Mozaic.Settings</RootNamespace>
    <ApplicationIcon>..\Mozaic\mozaic.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Mozaic Settings</Product>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mozaic.Core\Mozaic.Core.csproj" />
    <Compile Include="..\Shared\IpcProtocol.cs" Link="Shared\IpcProtocol.cs" />
    <Compile Include="..\Shared\Localization.cs" Link="Shared\Localization.cs" />
    <Compile Include="..\Shared\KeyboardModel.cs" Link="Shared\KeyboardModel.cs" />
    <Resource Include="..\Mozaic\mozaic.ico" Link="mozaic.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

</Project>
