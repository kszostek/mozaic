<UserControl x:Class="Mozaic.Settings.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mozaic.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36" MaxWidth="1040">
            <TextBlock Text="{l:T Appearance}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T 'Gaps, borders, colors and font. The preview updates as you change things.'}" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Card}" Padding="16">
                <l:LayoutPreview />
            </Border>

            <TextBlock Text="{l:T Gaps}" Style="{StaticResource SectionTitle}" />
            <l:SettingRow Icon="&#xE8A9;" Title="{l:T Between windows}" Description="{l:T 'Space between neighbouring windows, in pixels at 100% scaling.'}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="40" Width="220" Value="{Binding GapsInner}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GapsInner}" Width="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </l:SettingRow>
            <l:SettingRow Icon="&#xE740;" Title="{l:T At the screen edges}" Description="{l:T 'Added to the gap between windows.'}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="40" Width="220" Value="{Binding GapsOuter}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GapsOuter}" Width="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </l:SettingRow>
            <l:SettingRow Icon="&#xE73F;" Title="{l:T Smart gaps}" Description="{l:T 'No gaps when a workspace has only one window.'}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SmartGaps}" />
            </l:SettingRow>

            <TextBlock Text="{l:T Borders}" Style="{StaticResource SectionTitle}" />
            <l:SettingRow Icon="&#xE790;" Title="{l:T Colored window borders}"
                          Description="{l:T 'Windows 11 draws the border of each window in the colors below (focused / unfocused).'}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WindowBorderColors}" />
            </l:SettingRow>
            <l:SettingRow Icon="&#xE81E;" Title="{l:T Thick focus frame}" Description="{l:T 'Extra frame around the focused window, like i3 (0 = off).'}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="8" Width="220" Value="{Binding BorderWidth}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BorderWidth}" Width="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </l:SettingRow>
            <l:SettingRow Icon="&#xE71A;" Title="{l:T Rounding of the focus frame}" Description="{l:T 'Corner radius of the frame above, in pixels (0 = square).'}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="30" Width="220" Value="{Binding BorderRadius}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BorderRadius}" Width="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </l:SettingRow>
            <l:SettingRow Icon="&#xE71A;" Title="{l:T Window corners}">
                <ComboBox ItemsSource="{Binding Source={x:Static l:SettingsModel.CornerOptions}}" SelectedValuePath="Value" DisplayMemberPath="Label"
                          SelectedValue="{Binding CornerStyle}" MinWidth="220" />
            </l:SettingRow>

            <TextBlock Text="{l:T Title bars}" Style="{StaticResource SectionTitle}" />
            <l:SettingRow Icon="&#xE737;" Title="{l:T Title bars above windows}"
                          Description="{l:T 'Mozaic draws a title bar above every tiled window. Tabbed and stacked containers always have tabs, which look the same.'}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TitleBars}" />
            </l:SettingRow>
            <l:SettingRow Icon="&#xE71D;" Title="{l:T Application icon}" Description="{l:T 'Show the icon of the application at the start of title bars and tabs.'}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TitleBarIcons}" />
            </l:SettingRow>
            <l:SettingRow Icon="&#xE71A;" Title="{l:T Rounding of title bars}" Description="{l:T 'Corner radius of title bars and tabs, in pixels (0 = square).'}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="16" Width="220" Value="{Binding TitleBarRadius}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TitleBarRadius}" Width="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </l:SettingRow>
            <l:SettingRow Icon="&#xE8B0;" Title="{l:T Buttons}" Description="{l:T 'Buttons on title bars and on the active tab. Each acts on its own tile.'}">
                <WrapPanel MaxWidth="460" HorizontalAlignment="Right">
                    <CheckBox Content="{l:T 'Split (where the next window opens)'}" IsChecked="{Binding ButtonSplit}" Margin="0,0,16,4" />
                    <CheckBox Content="{l:T 'Layout (split, stacked, tabbed)'}" IsChecked="{Binding ButtonLayout}" Margin="0,0,16,4" />
                    <CheckBox Content="{l:T Floating}" IsChecked="{Binding ButtonFloating}" Margin="0,0,16,4" />
                    <CheckBox Content="{l:T Full screen}" IsChecked="{Binding ButtonFullscreen}" Margin="0,0,16,4" />
                    <CheckBox Content="{l:T Close}" IsChecked="{Binding ButtonClose}" Margin="0,0,16,4" />
                </WrapPanel>
            </l:SettingRow>

            <TextBlock Text="{l:T Effects}" Style="{StaticResource SectionTitle}" />
            <l:SettingRow Icon="&#xE945;" Title="{l:T Group lines}"
                          Description="{l:T 'Lines in the gaps between windows of the same tile show which windows belong together. A current flows along them when the focus or layout changes.'}">
                <ComboBox ItemsSource="{Binding Source={x:Static l:SettingsModel.GroupLineOptions}}" SelectedValuePath="Value" DisplayMemberPath="Label"
                          SelectedValue="{Binding GroupLines}" MinWidth="220" />
            </l:SettingRow>
            <l:SettingRow Icon="&#xE790;" Title="{l:T Color of the current}" Description="{l:T 'Color of the group lines and the current flowing along them.'}">
                <l:ColorBox Color="{Binding GroupLinesColor}" />
            </l:SettingRow>
            <l:SettingRow Icon="&#xE706;" Title="{l:T Fade windows you are not using}"
                          Description="{l:T 'The active window is opaque; the longer ago a window was used, the more transparent it gets.'}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InactiveOpacityOn}" />
            </l:SettingRow>
            <l:SettingRow Icon="&#xE706;" Title="{l:T Previously used window}" Description="{l:T 'Opacity of the window you used before the active one.'}"
                          IsEnabled="{Binding InactiveOpacityOn}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="30" Maximum="100" Width="220" Value="{Binding OpacityLastUsed}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OpacityLastUsed, StringFormat={}{0}%}" Width="44" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </l:SettingRow>
            <l:SettingRow Icon="&#xE706;" Title="{l:T Windows used long ago}" Description="{l:T 'Older windows fade down to this opacity.'}"
                          IsEnabled="{Binding InactiveOpacityOn}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="30" Maximum="100" Width="220" Value="{Binding OpacityMin}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OpacityMin, StringFormat={}{0}%}" Width="44" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </l:SettingRow>

            <TextBlock Text="{l:T Font}" Style="{StaticResource SectionTitle}" />
            <l:SettingRow Icon="&#xE8D2;" Title="{l:T 'Font of the bar, tabs and launcher'}">
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Source={x:Static l:SettingsModel.FontFamilies}}" Width="230"
                              IsEditable="True" Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}" />
                    <Slider Minimum="7" Maximum="16" Width="120" Margin="14,0,0,0" Value="{Binding FontSize}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FontSize}" Width="30" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </l:SettingRow>

            <TextBlock Text="{l:T Window colors}" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{l:T Window border}" Style="{StaticResource Secondary}" />
                        <TextBlock Grid.Column="2" Text="{l:T Tab background}" Style="{StaticResource Secondary}" />
                        <TextBlock Grid.Column="3" Text="{l:T Tab border}" Style="{StaticResource Secondary}" />
                        <TextBlock Grid.Column="4" Text="{l:T Tab text}" Style="{StaticResource Secondary}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ClientColors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <l:ColorBox Grid.Column="1" Color="{Binding ChildBorder}" HorizontalAlignment="Left" />
                                    <l:ColorBox Grid.Column="2" Color="{Binding Background}" HorizontalAlignment="Left" />
                                    <l:ColorBox Grid.Column="3" Color="{Binding Border}" HorizontalAlignment="Left" />
                                    <l:ColorBox Grid.Column="4" Color="{Binding Text}" HorizontalAlignment="Left" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
