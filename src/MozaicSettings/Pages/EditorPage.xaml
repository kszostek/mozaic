<UserControl x:Class="Mozaic.Settings.Pages.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mozaic.Settings"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit">
    <DockPanel Margin="36,28,36,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T Config file}" Style="{StaticResource PageTitle}" />
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="OpenFolder_Click" Padding="12,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock Text="{l:T Open folder}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="Defaults_Click" Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock Text="{l:T Restore defaults}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="PathText" Style="{StaticResource Secondary}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" />
            </DockPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" x:Name="ErrorPanel" Style="{StaticResource Card}" Margin="0,8,0,0" MaxHeight="150"
                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}">
            <ListBox x:Name="ErrorList" ItemsSource="{Binding Errors}" BorderThickness="0" Background="Transparent"
                     MouseDoubleClick="ErrorList_DoubleClick" ToolTip="{l:T Double-click to go to the line}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{Binding}" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Border Style="{StaticResource Card}" Padding="0" Margin="0">
            <ae:TextEditor x:Name="Editor" ShowLineNumbers="True" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                           WordWrap="False" Padding="8,6" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                           Background="Transparent" />
        </Border>
    </DockPanel>
</UserControl>
