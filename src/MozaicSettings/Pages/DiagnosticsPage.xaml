<UserControl x:Class="Mozaic.Settings.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mozaic.Settings">
    <DockPanel Margin="36,28,36,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T Diagnostics}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{l:T 'See which windows Mozaic manages and why others are left alone. Run any i3 command.'}" />
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{l:T Reload}" Click="Reload_Click" Padding="12,5" Margin="0,0,6,0" />
                        <Button Content="{l:T Restart}" Click="Restart_Click" Padding="12,5" Margin="0,0,6,0" />
                        <Button Content="{l:T Open log}" Click="Log_Click" Padding="12,5" />
                    </StackPanel>
                    <TextBlock x:Name="Info" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="Run_Click" Padding="14,5" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{l:T Run}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{l:T Command}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="CommandBox" FontFamily="{StaticResource MonoFont}" KeyDown="CommandBox_KeyDown" />
                </DockPanel>
            </Border>
            <TextBlock x:Name="CommandResult" Style="{StaticResource Secondary}" Margin="4,0,0,4" FontFamily="{StaticResource MonoFont}" />
            <DockPanel Margin="0,14,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="CreateRule_Click" Padding="12,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock Text="{l:T Create a rule for this window}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="Refresh_Click" Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock Text="{l:T Refresh}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{l:T Open windows}" Style="{StaticResource SectionTitle}" Margin="2,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
        <ListView x:Name="WindowList" BorderThickness="0" Background="Transparent">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{l:T Title}" Width="340" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="{l:T Program}" Width="170" DisplayMemberBinding="{Binding Process}" />
                    <GridViewColumn Header="{l:T Status}" Width="130" DisplayMemberBinding="{Binding VerdictLabel}" />
                    <GridViewColumn Header="{l:T Reason}" Width="300" DisplayMemberBinding="{Binding ReasonLabel}" />
                    <GridViewColumn Header="{l:T Class}" Width="200" DisplayMemberBinding="{Binding Class}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
