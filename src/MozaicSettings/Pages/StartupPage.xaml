<UserControl x:Class="Mozaic.Settings.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mozaic.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36" MaxWidth="1040">
            <TextBlock Text="{l:T Startup}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T 'Start Mozaic with Windows and run programs when it starts.'}" Style="{StaticResource PageSubtitle}" />

            <l:SettingRow Icon="&#xE7E8;" Title="{l:T Start Mozaic with Windows}" Description="{l:T 'Applied immediately (current user only).'}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
            </l:SettingRow>

            <DockPanel Margin="0,22,0,8">
                <Button DockPanel.Dock="Right" Click="Add_Click" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="{l:T Add program}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{l:T Programs started with Mozaic}" Style="{StaticResource SectionTitle}" Margin="2,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,8"
                       Text="{l:T 'A command line such as notepad.exe or wt.exe. Also on reload: run again every time the configuration is reloaded.'}" />
            <ItemsControl ItemsSource="{Binding Execs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Click="Delete_Click" Tag="{Binding}" Padding="8,4" Margin="12,0,0,0" ToolTip="{l:T Delete}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" />
                                </Button>
                                <CheckBox DockPanel.Dock="Right" Content="{l:T Also on reload}" IsChecked="{Binding Always}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Command, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
