<UserControl x:Class="Mozaic.Settings.Pages.GuidePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mozaic.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36" MaxWidth="1300">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="/mozaic.ico" Width="60" Height="60" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="{l:T Welcome to Mozaic}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" FontSize="14"
                               Text="{l:T 'Mozaic arranges your windows automatically, side by side and without overlapping, the way the i3 window manager does on Linux. Everything works from the keyboard, and the mouse works too.'}" />
                </StackPanel>
            </Grid>

            <Border x:Name="NotRunning" Style="{StaticResource Card}" Margin="0,4,0,4" Visibility="Collapsed"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:T Start Mozaic}" Click="Start_Click" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,14,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="{l:T 'Mozaic is not running. The shortcuts below work while it runs.'}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <DockPanel Margin="0,18,0,6">
                <ListBox x:Name="Layers" DockPanel.Dock="Right" ItemContainerStyle="{StaticResource PillItem}" BorderThickness="0"
                         Background="Transparent" SelectionChanged="Layers_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="{l:T Keyboard shortcuts}" Style="{StaticResource SectionTitle}" Margin="2,0,0,0" VerticalAlignment="Center" FontSize="18" />
            </DockPanel>
            <TextBlock x:Name="LayerHint" Style="{StaticResource Secondary}" FontSize="13" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="14">
                <l:KeyboardView x:Name="Keyboard" />
            </Border>
            <WrapPanel x:Name="Legend" Margin="4,10,0,0" />

            <TextBlock Text="{l:T The basics}" Style="{StaticResource SectionTitle}" FontSize="18" Margin="2,26,0,10" />
            <UniformGrid x:Name="Basics" Columns="2" />

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Welcome}" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="20" Margin="2,0,18,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T Show this guide when Mozaic starts}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{l:T 'Takes effect after saving. You can always open it from the tray icon.'}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Click="Shortcuts_Click" Padding="14,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Text="{l:T Change shortcuts}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Click="GitHub_Click" Padding="14,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Text="{l:T Documentation on GitHub}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Click="I3_Click" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Text="{l:T i3 User Guide}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
