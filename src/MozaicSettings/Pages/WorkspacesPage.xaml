<UserControl x:Class="Mozaic.Settings.Pages.WorkspacesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mozaic.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36" MaxWidth="1040">
            <TextBlock Text="{l:T Workspaces}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{l:T 'Give workspaces names (for example 2:web; the number keeps the shortcut working) and pin them to a monitor.'}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{l:T Name}" Style="{StaticResource Secondary}" />
                        <TextBlock Grid.Column="2" Text="{l:T Monitor}" Style="{StaticResource Secondary}" Margin="16,0,0,0" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7C4;" Style="{StaticResource Icon}" />
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Editable}" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding OutputOptions}" SelectedItem="{Binding Output}" Margin="16,0,0,0" MinWidth="220"
                                              HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource AnyOutput}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Secondary}" Margin="2,10,0,0"
                       Text="{l:T 'Monitor names (DISPLAY1, DISPLAY2…) come from the running Mozaic. primary is the main monitor.'}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
