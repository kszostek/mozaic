<UserControl x:Class="Mozaic.Settings.Pages.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mozaic.Settings">
    <DockPanel Margin="36,28,36,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T Window rules}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{l:T 'Decide what happens to particular applications: float them, open them on a workspace or leave them alone. Pick a running window to fill in the details.'}" />
            <DockPanel Margin="0,2,0,12">
                <Button DockPanel.Dock="Right" Click="Add_Click" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{l:T Add rule}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock />
            </DockPanel>
        </StackPanel>
        <ListBox x:Name="List" ItemsSource="{Binding Rules}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="List_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource KeyPill}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Criteria}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Click="Edit_Click" Tag="{Binding}" Padding="8,4" Margin="0,0,4,0" ToolTip="{l:T Edit}">
                                <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13" />
                            </Button>
                            <Button Click="Delete_Click" Tag="{Binding}" Padding="8,4" ToolTip="{l:T Delete}">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
